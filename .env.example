# ════════════════════════════════════════════════════════════════════
# 코랩에서는 이 파일이 필요 없습니다.
#   왼쪽 사이드바 🔑 → 이름/값 입력 → '노트북 액세스' 켜기
#   (노트북에 키를 적으면 공유하는 순간 새어 나갑니다)
#
# 로컬에서 같은 코드를 돌릴 때만 이 파일을 .env 로 복사해 쓰세요.
#   cp .env.example .env
# ════════════════════════════════════════════════════════════════════

# ── 데이터 ──────────────────────────────────────────────────────────
# 비워 두면 후보 경로를 자동 탐색합니다 (README_COLAB.md 참고).
PENSION_DATA_DIR=

# ── 캐시 (코랩: 드라이브 경로를 주면 세션이 끊겨도 유지) ───────────
# colab_setup.setup() 이 자동으로 잡아 주므로 보통 비워 둡니다.
# PENSION_CACHE_DIR=/content/drive/MyDrive/pension_cache

# ── CLOVA Studio ────────────────────────────────────────────────────
# ⚠️ 실제 키는 .env 에만. 이 파일(.env.example)에는 절대 넣지 마세요.
CLOVA_API_KEY=
CLOVA_API_BASE=https://clovastudio.stream.ntruss.com

# 단계별 모델 — 호출 성격이 두 갈래로 갈린다.
#   판정/분류형(분해·라우팅·채점·재작성·HyDE) : 출력이 짧고 정답 공간이 좁다 → DASH
#   생성/검증형(답변·환각·품질·전략·합성)     : 사실 정확도가 곧 품질이다   → HCX-005
CLOVA_MODEL_PLAN=HCX-DASH-002
CLOVA_MODEL_GRADE=HCX-DASH-002
CLOVA_MODEL_ANSWER=HCX-005
CLOVA_MODEL_VERIFY=HCX-005
# 아래 셋은 호출 수가 적지만 틀리면 문항 하나가 통째로 망가지는 자리라 HCX-005 로 둔다.
# (분해 = 질문당 1~2회, 안전성 = 1회, 복구 = 파싱 실패 시에만)
CLOVA_MODEL_DECOMPOSE=HCX-005
CLOVA_MODEL_SAFETY=HCX-005
CLOVA_MODEL_REPAIR=HCX-005

# 임베딩 모델을 못 올리는 환경에서만 켠다 (콜랩에서는 불필요).
# 모델이 도는 환경에서 켜고 한 번 돌려 cache/emb_query_*.jsonl 을 데운 뒤,
# 그 파일을 못 도는 환경으로 옮기면 모델 없이 같은 검색이 재현된다.
# PENSION_EMBED_QUERY_CACHE=true
# PENSION_EMBED_STRICT=true

# ── 토큰 계측 ───────────────────────────────────────────────────────
# COUNT_TOKENS   : 응답 usage 로 사후 집계 (추가 호출 없음)
# PRECOUNT_TOKENS: Tokenizer API 로 호출 전에 입력 토큰을 미리 잰다 (호출 2배)
PENSION_COUNT_TOKENS=true
PENSION_PRECOUNT_TOKENS=false

# ── 임베딩 ──────────────────────────────────────────────────────────
# 코랩에서 GPU 를 켜면 디바이스는 자동으로 cuda 가 됩니다.
# 메모리가 빠듯하면 base(768) 또는 small(384)로 내리세요 — DIM 도 함께 바꿀 것.
PENSION_EMBED_MODEL=intfloat/multilingual-e5-large
PENSION_EMBED_DIM=1024
# PENSION_EMBED_DEVICE=cuda
# PENSION_EMBED_BATCH=64

# ── 네이버 검색 API (문서에서 못 찾았을 때의 폴백) ──────────────────

# ── 검색 파라미터 (성능 실험 시 여기를 바꿔가며 비교) ───────────────
PENSION_TOP_K=5
PENSION_TOP_K_RECOMMEND=24
PENSION_BM25_W=0.35
PENSION_VEC_W=0.65
PENSION_DISTRACTOR_PENALTY=0.35
PENSION_TABLE_BOOST=1.25
PENSION_USE_CONFIDENCE=true

# ── 재시도·예산 (무한루프와 비용 폭주 방지) ─────────────────────────
PENSION_MAX_GRADE_RETRY=2
PENSION_MAX_VERIFY_RETRY=1
PENSION_MAX_SUBQ=4
PENSION_MAX_ROUNDS=2
PENSION_LLM_BUDGET=40
