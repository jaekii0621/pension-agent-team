# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   copy .env.example .env      (Windows)

# ════════════════════════════════════════════════════════════════════
# 데이터
# ════════════════════════════════════════════════════════════════════
# 파싱 완료된 JSONL 이 있는 폴더
# (프로젝트 루트를 적어도 config 가 하위 data/ 를 자동으로 찾는다)
PENSION_DATA_DIR=./data

# ════════════════════════════════════════════════════════════════════
# CLOVA Studio (HyperCLOVA X)
# ════════════════════════════════════════════════════════════════════
# ⚠️ 실제 키는 .env 에만 넣고, 이 파일(.env.example)에는 절대 넣지 마세요.
CLOVA_API_KEY=
CLOVA_API_BASE=https://clovastudio.stream.ntruss.com

# ── 단계별 모델 ─────────────────────────────────────────────────────
# 호출 성격이 두 갈래로 갈린다.
#   판정/분류형(분해·라우팅·채점·재작성·HyDE) : 출력이 짧고 정답 공간이 좁다 → DASH
#   생성/검증형(답변·환각·품질·전략·합성)     : 사실 정확도가 곧 품질이다   → HCX-005
CLOVA_MODEL_PLAN=HCX-DASH-002
CLOVA_MODEL_GRADE=HCX-DASH-002
CLOVA_MODEL_ANSWER=HCX-005
CLOVA_MODEL_VERIFY=HCX-005

# ── 토큰 계측 ───────────────────────────────────────────────────────
# COUNT_TOKENS   : 응답 usage 로 사후 집계 (추가 호출 없음)
# PRECOUNT_TOKENS: Tokenizer API 로 호출 전에 입력 토큰을 미리 잰다 (호출 2배)
PENSION_COUNT_TOKENS=true
PENSION_PRECOUNT_TOKENS=false

# ── 임베딩: multilingual-e5-large (로컬 실행) ───────────────────────
#   설치: pip install sentence-transformers
#   첫 실행 시 모델을 내려받는다(약 2.2GB). 이후엔 네트워크 불필요.
PENSION_EMBED_MODEL=intfloat/multilingual-e5-large
PENSION_EMBED_DIM=1024
PENSION_EMBED_BATCH=32
# PENSION_EMBED_DEVICE=cuda

# ════════════════════════════════════════════════════════════════════
# 네이버 검색 API (문서에서 못 찾았을 때의 폴백)
#   https://developers.naver.com/apps 에서 '검색' API 등록
# ════════════════════════════════════════════════════════════════════
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ════════════════════════════════════════════════════════════════════
# 검색 파라미터 (성능 실험 시 여기를 바꿔가며 비교)
# ════════════════════════════════════════════════════════════════════
PENSION_TOP_K=5
PENSION_TOP_K_RECOMMEND=24
PENSION_BM25_W=0.35
PENSION_VEC_W=0.65
PENSION_DISTRACTOR_PENALTY=0.35
PENSION_TABLE_BOOST=1.25
PENSION_USE_CONFIDENCE=true

# ════════════════════════════════════════════════════════════════════
# 재시도·예산 (무한루프와 비용 폭주 방지)
# ════════════════════════════════════════════════════════════════════
PENSION_MAX_GRADE_RETRY=2
PENSION_MAX_VERIFY_RETRY=1
PENSION_MAX_SUBQ=4
PENSION_MAX_ROUNDS=2
PENSION_LLM_BUDGET=40
